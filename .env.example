# Smart ATS environment contract.
# Copy to .env and fill in secrets. Hostnames are Docker Compose service names;
# replace them with localhost when running a process directly on the host.

# --- PostgreSQL (Infra 02, ADR-0001) ---------------------------------------
# Bootstrap superuser, used only by the container's init scripts.
POSTGRES_DB=smart_ats
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host port published for tools and smoke tests; change it if 5432 is taken.
POSTGRES_HOST_PORT=5432
# Passwords the init script assigns to the two runtime roles;
# keep them in sync with the URLs below.
ATS_OWNER_PASSWORD=ats_owner_dev
ATS_APP_PASSWORD=ats_app_dev
# Migrations (Alembic) run as ats_owner, which owns the tables.
DATABASE_MIGRATION_URL=postgresql+psycopg://ats_owner:ats_owner_dev@postgres:5432/smart_ats
# API and workers run as ats_app: DML only, no BYPASSRLS.
DATABASE_URL=postgresql+psycopg://ats_app:ats_app_dev@postgres:5432/smart_ats

# --- Redis: Celery broker, SSE pub/sub, rate limits (Infra 03) --------------
REDIS_URL=redis://redis:6379/0
# Host port published for tools and smoke tests; change it if 6379 is taken.
REDIS_HOST_PORT=6379
# Flower dashboard login (user:password); use a strong one on the demo VPS.
FLOWER_BASIC_AUTH=admin:flower_dev

# --- S3 object storage (Infra 04) -------------------------------------------
# Leave S3_ENDPOINT and S3_PUBLIC_ENDPOINT empty in production to use AWS S3.
S3_ENDPOINT=http://seaweedfs:8333
# Host the browser can reach; presigned URLs are signed against it.
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=smart-ats-dev
S3_SECRET_ACCESS_KEY=smart-ats-dev-secret
S3_BUCKET=smart-ats-media

# --- Email over SMTP: Mailpit locally, SES/Resend SMTP in production (Infra 04)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="Smart ATS <no-reply@smart-ats.local>"

# --- Auth (FR-C1.1, ADR-0003) -----------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- URLs -------------------------------------------------------------------
# Unified origin exposed by Caddy (Infra 06); CORS, email links, and browser API calls.
WEB_BASE_URL=https://localhost
NEXT_PUBLIC_API_URL=https://localhost

# --- AI (SRS §9.1) ----------------------------------------------------------
OPENAI_API_KEY=
LLM_REASONING_MODEL=gpt-6-sol
LLM_EXTRACTION_MODEL=gpt-6-luna
# Must produce 1536-dim vectors (ADR-0005); changing it means re-embedding.
EMBEDDING_MODEL=text-embedding-3-large
# Mock AI: no OpenAI calls; canned responses after an artificial delay
# (SRS §8.5 load tests use a realistic latency, local dev uses 0).
AI_MOCK=true
AI_MOCK_LATENCY_MS=0
